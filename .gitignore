# ============================================================
# 永动知识图谱 Agent - Git忽略配置
# 公理溯源: 存续公理 - 保护运行时数据与系统稳定性
# ============================================================

# Python 字节码
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
.venv/
env/
.env/
ENV/

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/
.tox/

# 运行时数据 (知识图谱、任务队列、日志)
data/*.json
data/*.log
data/*.bak
logs/
*.log

# 系统锁文件 (防止多实例冲突)
*.lock
*.pid

# 临时文件
*.tmp
*.temp
.DS_Store
Thumbs.db

# 分发与打包
dist/
build/
*.egg-info/
*.egg

# 本地配置覆盖
config.local.py
.env.local
